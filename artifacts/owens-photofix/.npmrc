# Prevent postinstall scripts from running during npm install on EAS Mac workers.
# "Exit handler never called!" crashes on macOS Sequoia 15.6 are caused by
# packages (e.g. @expo/ngrok) downloading platform binaries in postinstall.
# iOS native modules are compiled by Xcode during the EAS build — npm postinstall
# scripts are not needed and safe to skip.
ignore-scripts=true
