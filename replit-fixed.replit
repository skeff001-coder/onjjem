modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0", "stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 20664
externalPort = 4200

[[ports]]
localPort = 21626
externalPort = 3001

[[ports]]
localPort = 21627
externalPort = 80

[[ports]]
localPort = 24039
externalPort = 3003

[[ports]]
localPort = 25416
externalPort = 5000

[nix]
channel = "stable-25_05"
packages = ["eas-cli", "stripe-cli"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_OGJMpwWspeprzlqFUWyeEQENXee"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_QlAKzSnABwsXylEXGysyHrvnJpx"
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_PrynAABKWsJkuDGlYyEurZjjJGO"
REVENUECAT_PROJECT_ID = "proj2d8ef809"
PRODIGI_ENV = "live"
run = "pnpm start --filter api-server"
